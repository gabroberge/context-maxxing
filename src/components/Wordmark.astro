---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <svg width="22" height="22" viewBox="0 0 32 32" aria-hidden="true">
    <rect width="32" height="32" rx="7" fill="var(--color-raise)"></rect>
    <path
      d="M12 8 H8 V24 H12"
      stroke="var(--color-signal)"
      stroke-width="2.4"
      fill="none"
      stroke-linecap="round"></path>
    <path
      d="M20 8 H24 V24 H20"
      stroke="var(--color-signal)"
      stroke-width="2.4"
      fill="none"
      stroke-linecap="round"></path>
    <circle cx="16" cy="16" r="2.4" fill="var(--color-paper)"></circle>
  </svg>
  <span class="font-semibold tracking-tight text-paper"
    >ContextMaxxing<span class="align-super text-[0.55em] font-medium text-fog">™</span></span
  >
</span>
