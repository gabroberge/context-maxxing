---
const sources = [
  ['repositories', '14'],
  ['pull requests', '3,207'],
  ['architecture decisions', '118'],
  ['chat threads', '12,441'],
  ['production logs', 'streaming'],
  ['previous approvals', '2,930'],
  ['developer preferences', 'learned'],
];

const integrations = [
  'Git hosting',
  'Issue tracking',
  'Team chat',
  'Documentation',
  'CI / CD',
  'Observability',
  'Incident response',
  'Calendars',
];
---

<section id="top" class="relative overflow-hidden pt-16">
  <div class="grid-veil absolute inset-0" aria-hidden="true"></div>
  <div
    class="absolute left-1/2 top-[-14rem] h-[26rem] w-[46rem] -translate-x-1/2 rounded-full bg-signal/14 blur-[110px]"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-6xl px-5 pb-20 pt-20 sm:px-8 sm:pt-28">
    <div class="mx-auto max-w-3xl text-center">
      <p
        class="reveal mx-auto mb-6 inline-flex items-center gap-2 rounded-full border border-line bg-panel px-3.5 py-1.5 font-mono text-[11px] uppercase tracking-[0.14em] text-fog"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-ok"></span>
        Context infrastructure for autonomous engineering
      </p>
      <h1
        class="reveal text-balance text-4xl font-semibold leading-[1.06] tracking-tight sm:text-6xl"
      >
        Give your agents everything they need to move{' '}<span
          class="text-signal">without you.</span
        >
      </h1>
      <p class="reveal mx-auto mt-6 max-w-2xl text-pretty text-lg leading-relaxed text-fog">
        ContextMaxxing connects your repositories, documentation, decisions,
        conversations, and history into persistent context for autonomous coding
        agents — so work continues whether or not you're in the room.
      </p>
      <div class="reveal mt-9 flex flex-wrap items-center justify-center gap-4">
        <a
          href="#cta"
          class="rounded-lg bg-signal px-5 py-2.5 text-sm font-medium text-ink transition-colors hover:bg-[#9d9df7]"
          >Request early access</a
        >
        <a
          href="#platform"
          class="rounded-lg border border-line bg-panel px-5 py-2.5 text-sm font-medium text-paper transition-colors hover:border-fog/40"
          >See the platform</a
        >
      </div>
    </div>

    <!-- Terminal -->
    <div class="reveal mx-auto mt-16 max-w-2xl">
      <div
        class="overflow-hidden rounded-xl border border-line bg-panel shadow-[0_24px_80px_-24px_rgba(0,0,0,0.8)]"
      >
        <div class="flex items-center gap-2 border-b border-line px-4 py-3">
          <span class="h-2.5 w-2.5 rounded-full bg-line"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-line"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-line"></span>
          <span class="ml-2 font-mono text-xs text-dim">ctxmax — session 0441</span>
        </div>
        <div class="overflow-x-auto p-5 font-mono text-[13px] leading-6">
          <p><span class="text-dim">$</span> <span class="text-paper">ctxmax sync --scope everything</span></p>
          <div class="mt-2 text-fog">
            {
              sources.map(([name, value]) => (
                <p class="flex justify-between gap-6">
                  <span>
                    <span class="text-ok">✓</span> {name}
                  </span>
                  <span class="text-paper">{value}</span>
                </p>
              ))
            }
          </div>
          <p class="mt-2 border-t border-line pt-2 text-fog">
            <span class="flex justify-between gap-6">
              <span>tokens available</span>
              <span class="text-signal" id="token-counter" data-base="847293">847,293</span>
            </span>
          </p>
          <p class="mt-2 text-ok">
            ✓ agents cleared to proceed<span class="cursor-blink text-paper">▍</span>
          </p>
        </div>
      </div>
    </div>

    <!-- Integrations -->
    <div class="reveal mt-16 text-center">
      <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-dim">
        Ingests everything your team has ever written down
      </p>
      <ul class="mt-5 flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
        {
          integrations.map((name) => (
            <li class="text-sm font-medium text-dim">{name}</li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script>
  // Token counter ticks upward slowly — context only ever grows.
  const el = document.getElementById('token-counter');
  if (el) {
    let n = Number(el.dataset.base);
    const media = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (!media.matches) {
      setInterval(() => {
        n += Math.floor(Math.random() * 37) + 3;
        el.textContent = n.toLocaleString('en-US');
      }, 1400);
    }
  }
</script>
