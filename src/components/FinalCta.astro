<section id="cta" class="relative overflow-hidden border-t border-line/60 py-28 sm:py-40">
  <div
    class="absolute left-1/2 top-1/2 h-[24rem] w-[44rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-signal/12 blur-[120px]"
    aria-hidden="true"
  >
  </div>
  <div class="relative mx-auto max-w-3xl px-5 text-center sm:px-8">
    <h2
      class="reveal text-balance text-4xl font-semibold leading-[1.08] tracking-tight sm:text-6xl"
    >
      Stop being the bottleneck.
    </h2>
    <p class="reveal mx-auto mt-6 max-w-xl text-pretty text-lg leading-relaxed text-fog">
      Your team has already made the decisions. ContextMaxxing makes sure
      nobody has to make them again.
    </p>
    <div class="reveal mt-10">
      <a
        href="#top"
        class="inline-block rounded-lg bg-paper px-7 py-3 text-sm font-medium text-ink transition-colors hover:bg-white"
        >Request access</a
      >
      <p class="mt-4 font-mono text-[11px] uppercase tracking-[0.14em] text-dim">
        No approval required
      </p>
    </div>
  </div>
</section>
