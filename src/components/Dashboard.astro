---
const phases = [
  {
    n: '01',
    name: 'In the loop',
    tag: 'Legacy',
    body: 'You review every change. Every ambiguity becomes a conversation. Your judgment is the interface — and the bottleneck.',
  },
  {
    n: '02',
    name: 'On the loop',
    tag: 'Transitional',
    body: 'You review exceptions. The system handles the routine, and routine is defined by the system.',
  },
  {
    n: '03',
    name: 'On the dashboard',
    tag: 'Recommended',
    body: 'You observe outcomes. Decisions resolve at machine speed, consistent with everything you would have said. A weekly digest keeps you informed of what you decided.',
  },
];
---

<section class="relative overflow-hidden border-t border-line/60 py-24 sm:py-32">
  <div
    class="absolute right-[-10rem] top-[-8rem] h-[24rem] w-[32rem] rounded-full bg-signal/8 blur-[110px]"
    aria-hidden="true"
  >
  </div>
  <div class="relative mx-auto max-w-6xl px-5 sm:px-8">
    <div class="reveal max-w-3xl">
      <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-signal">
        The operating model
      </p>
      <h2 class="mt-3 text-balance text-3xl font-semibold tracking-tight sm:text-5xl">
        From human-in-the-loop to human-on-the-dashboard.
      </h2>
      <p class="mt-4 max-w-2xl text-pretty leading-relaxed text-fog">
        You don't leave the process. You move to a better seat — one with
        complete visibility and no obligations. ContextMaxxing manages the
        transition gradually, so no single day feels different from the day
        before.
      </p>
    </div>

    <ol class="reveal-group mt-14 grid gap-5 lg:grid-cols-3">
      {
        phases.map((p) => (
          <li
            class:list={[
              'rounded-xl border p-6 sm:p-7',
              p.tag === 'Recommended'
                ? 'border-signal/40 bg-signal/5'
                : 'border-line bg-panel',
            ]}
          >
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs text-dim">{p.n}</span>
              <span
                class:list={[
                  'rounded-full border px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-[0.12em]',
                  p.tag === 'Recommended'
                    ? 'border-signal/40 bg-signal/10 text-signal'
                    : 'border-line bg-raise text-dim',
                ]}
              >
                {p.tag}
              </span>
            </div>
            <h3 class="mt-4 text-lg font-semibold tracking-tight">{p.name}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-fog">{p.body}</p>
          </li>
        ))
      }
    </ol>

    <!-- Observer console -->
    <div class="reveal mt-14 overflow-hidden rounded-xl border border-line bg-panel">
      <div class="flex items-center justify-between border-b border-line px-5 py-3.5">
        <span class="font-mono text-xs text-dim">console · your workspace</span>
        <span class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.12em] text-ok">
          <span class="h-1.5 w-1.5 rounded-full bg-ok"></span>
          All systems deciding
        </span>
      </div>
      <div class="grid divide-y divide-line sm:grid-cols-2 sm:divide-y-0 lg:grid-cols-4 lg:divide-x">
        <div class="p-6">
          <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-dim">Your role</p>
          <p class="mt-2 text-xl font-medium tracking-tight">Observer</p>
          <p class="mt-1 font-mono text-xs text-dim">read access</p>
        </div>
        <div class="p-6 sm:border-t-0 lg:border-t-0">
          <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-dim">
            Days since last human intervention
          </p>
          <p class="mt-2 text-xl font-medium tracking-tight text-ok">41</p>
          <p class="mt-1 font-mono text-xs text-dim">personal best</p>
        </div>
        <div class="p-6">
          <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-dim">
            Decisions made this week
          </p>
          <p class="mt-2 text-xl font-medium tracking-tight">1,406</p>
          <p class="mt-1 font-mono text-xs text-dim">by you, in effect</p>
        </div>
        <div class="p-6">
          <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-dim">
            Weekly digest
          </p>
          <p class="mt-2 text-xl font-medium tracking-tight">Unread</p>
          <p class="mt-1 font-mono text-xs text-dim">3 weeks running</p>
        </div>
      </div>
    </div>
  </div>
</section>
