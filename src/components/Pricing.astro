---
const tiers = [
  {
    name: 'Developer',
    price: '$49',
    unit: '/seat/mo',
    blurb: 'For teams still answering questions.',
    features: [
      '200K context per agent',
      'Questions routed to you',
      'Manual approvals',
      'Standard support',
    ],
    featured: false,
    cta: 'Start free trial',
  },
  {
    name: 'Staff',
    price: '$199',
    unit: '/seat/mo',
    blurb: 'For teams ready to be asked less.',
    features: [
      '1M context per agent',
      'Automatic Decision Resolution™',
      'Interrupt Budget: 5 per week',
      'Human-in-the-Loop Simulation™',
    ],
    featured: false,
    cta: 'Start free trial',
  },
  {
    name: 'Principal',
    price: '$499',
    unit: '/seat/mo',
    blurb: 'For teams that have already said everything they need to say.',
    features: [
      'Unlimited organizational memory',
      'Autonomous Approval™',
      'Self-Healing Governance™',
      'Interrupt Budget: 0',
      'Weekly digest of your decisions',
    ],
    featured: true,
    cta: 'Start free trial',
  },
  {
    name: 'Enterprise',
    price: 'Custom',
    unit: '',
    blurb: 'For organizations with governance requirements.',
    features: [
      'Everything in Principal',
      'SSO and audit exports',
      'Dedicated context engineer',
      'Custom accountability',
    ],
    featured: false,
    cta: 'Talk to sales',
  },
];
---

<section id="pricing" class="border-t border-line/60 py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="reveal max-w-2xl">
      <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-signal">
        Pricing
      </p>
      <h2 class="mt-3 text-balance text-3xl font-semibold tracking-tight sm:text-4xl">
        Priced by how little we need you.
      </h2>
      <p class="mt-4 text-pretty leading-relaxed text-fog">
        Every tier includes unlimited agents, unlimited ingestion, and full
        decision transcripts. What varies is how often anyone has to talk to
        you.
      </p>
    </div>

    <div class="reveal-group mt-14 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
      {
        tiers.map((t) => (
          <article
            class:list={[
              'flex flex-col rounded-xl border p-6 sm:p-7',
              t.featured
                ? 'border-signal/40 bg-signal/5'
                : 'border-line bg-panel',
            ]}
          >
            <div class="flex items-center justify-between">
              <h3 class="font-semibold tracking-tight">{t.name}</h3>
              {t.featured && (
                <span class="rounded-full border border-signal/40 bg-signal/10 px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-[0.12em] text-signal">
                  Most popular
                </span>
              )}
            </div>
            <p class="mt-4 flex items-baseline gap-1">
              <span class="text-3xl font-semibold tracking-tight">{t.price}</span>
              <span class="text-sm text-dim">{t.unit}</span>
            </p>
            <p class="mt-2 min-h-10 text-sm leading-snug text-fog">{t.blurb}</p>
            <ul class="mt-5 flex-1 space-y-2.5 border-t border-line pt-5 text-sm text-fog">
              {t.features.map((f) => (
                <li class="flex gap-2.5">
                  <span class="mt-0.5 text-ok">✓</span>
                  {f}
                </li>
              ))}
            </ul>
            <a
              href="#cta"
              class:list={[
                'mt-7 rounded-lg px-4 py-2 text-center text-sm font-medium transition-colors',
                t.featured
                  ? 'bg-signal text-ink hover:bg-[#9d9df7]'
                  : 'border border-line bg-raise text-paper hover:border-fog/40',
              ]}
            >
              {t.cta}
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
